Step.start("perf (multithread)")

bench_start = Build.now_ms()
Build.run({"./target/release/dav1d", "-q", "-i", "/files/Chimera-AV1-8bit-1920x1080-6736kbps.ivf", "-o", "/dev/null"})
bench_end = Build.now_ms()
Build.metric("uninstrumented runtime (ms) (multithread)", bench_end - bench_start)

bench_start = Build.now_ms()
perf_out = Build.check_output({
  "/files/perf", "stat", "-x", ";", "-e",
  "cycles,instructions,cpu-clock,stalled-cycles-frontend,stalled-cycles-backend,ic_cache_fill_l2,ic_cache_fill_sys,ic_tag_hit_miss.all_instruction_cache_accesses,ic_tag_hit_miss.instruction_cache_miss,ls_dispatch.all",
  "./target/release/dav1d", "-q", "-i", "/files/Chimera-AV1-8bit-1920x1080-6736kbps.ivf", "-o", "/dev/null"
})
bench_end = Build.now_ms()

measurements = {}

for count, unit, name in perf_out.stderr:gmatch("([^;]*);([^;]*);([^;]*)[^\n]*\n?") do
  if name ~= nil and name ~= "" then
    measurements[name] = tonumber(count)
    Build.metric("multithread " .. name, tonumber(count))
  end
end

ipc = measurements["instructions"] / measurements["cycles"]
hz = measurements["cycles"] / measurements["cpu-clock"]
backend_stall_pct = measurements["stalled-cycles-backend"] / measurements["cycles"]
frontend_stall_pct = measurements["stalled-cycles-frontend"] / measurements["cycles"]
Build.metric("multithread IPC", string.format("%.3f", ipc))
Build.metric("multithread GHz", string.format("%.3f", hz / 1000000))
Build.metric("multithread Backend stall %", string.format("%.3f", backend_stall_pct * 100))
Build.metric("multithread Frontend stall %", string.format("%.3f", frontend_stall_pct * 100))

